# Copy to .env (project root) and fill in. .env is never committed.

# Supabase — use the SERVICE ROLE key (full write access; used by the batch)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Gemini (used from Phase 4 onward)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Folder of Bauwerksbuch PDFs to process (Phase 7)
PDF_INPUT_DIR=./pdfs
